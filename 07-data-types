#!/bin/bash

var1=10
var2=20

echo "$var1+$var2"              # Output will be 10+20
echo "$((var1 + var2))"         # Output will be 30


declare -i COUNT=5
NUMBER=$((COUNT+1))   # Its in arthematice for $(()) 

echo "$COUNT"                    # Output will be 5
echo "$NUMBER"                   # Output will be 6

FRUITS=("Apple" "Banana" "Cherry") # This is list of values \ strings is call ARRAY
echo "All Fruits: ${FRUITS[@]}"          # Output will be All Fruits: Apple Banana Cherry
echo "First Fruit: ${FRUITS[0]}"         # Output will be First Fruit: Apple        
echo "Second Fruit: ${FRUITS[1]}"        # Output will be Second Fruit: Banana



